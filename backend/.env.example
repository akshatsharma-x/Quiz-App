# ---- Server --------------------------------------------------------------------------
PORT=5001
NODE_ENV=development
# Comma-separated list of allowed browser origins for the API (default: any)
# CORS_ORIGIN=http://localhost:5502,http://localhost:8080

# ---- Database ------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/quizmuj

# ---- Auth ----------------------------------------------------------------------------
# Use a long random string in production, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d
# Only this domain may register as a student
STUDENT_EMAIL_DOMAIN=muj.manipal.edu

# First administrator, created automatically when no admin exists
ADMIN_EMAIL=admin@quizmuj.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=QuizMUJ Admin

# ---- Email (one-time codes) ---------------------------------------------------------------
# Option 1 – Brevo HTTPS API (works on hosts that block SMTP, e.g. Render's free plan):
# BREVO_API_KEY=xkeysib-...
# FROM_EMAIL=you@gmail.com        # must be a sender verified in Brevo
#
# Option 2 – SMTP (e.g. Gmail with an App Password):
# With NODE_ENV=development and no email configured, codes are printed to the server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
# For Gmail use an App Password (Google Account → Security → App passwords)
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=QuizMUJ

# ---- Public showcase -----------------------------------------------------------------------
# Adds one-click demo logins and rebuilds the demo dataset on every boot (and every 6 h).
# WARNING: wipes ALL quizzes, attempts, announcements and bank questions each time – use a
# dedicated database.
# SHOWCASE_MODE=true

# ---- Behind a proxy / load balancer ----------------------------------------------------
# Number of proxy hops in front of the app (Render / Railway / Fly.io: 1), or a list such as
# "loopback, uniquelocal" (docker-compose behind nginx). Needed for per-student rate limits.
# TRUST_PROXY=1

# ---- Optional tuning --------------------------------------------------------------------
# Timezone used for the admin activity chart
# APP_TIMEZONE=Asia/Kolkata
# Seconds of grace after a deadline for submissions in flight (ms)
# SUBMISSION_GRACE_MS=30000
# Auth rate limits per 15 minutes: per account (+network) and per network (set RATE_LIMIT=off in tests)
# RATE_LIMIT_AUTH=20
# RATE_LIMIT_EMAIL=6
# RATE_LIMIT_NETWORK=3000
